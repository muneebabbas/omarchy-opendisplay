#!/usr/bin/env bash
# omarchy-opendisplay: helper for the OpenDisplay Omarchy bar widget.
#
# Drives the official od-sender CLI; never reimplements the protocol. Sessions
# run as systemd user units so they outlive shell restarts:
#   manual connect   opendisplay-<id8>.service        (transient, systemd-run)
#   connect by IP    opendisplay-addr-<sha1-8>.service (transient)
#   connect by USB   opendisplay-usb-<id8>.service    (transient; bin/usbmux.py
#                    forwards a loopback port to the device and runs od-sender)
#   auto-connect     od-sender@<escaped id>.service   (upstream template unit)
#
# Every value from outside is validated before use and always passed as a
# separate argument; nothing is ever evaluated as shell code.

set -uo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PY=(python3 -I)
UTIL="$HERE/opendisplay-util.py"
USBMUX="$HERE/usbmux.py"
CONFIG_TOOL="$HERE/sender-config.py"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-opendisplay"
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
LOCKS="$RUNTIME/opendisplay"
STATE="$RUNTIME/omarchy-opendisplay"
SETTINGS="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-opendisplay"
# Wi-Fi connections are off while this file exists (the single source of
# truth; opendisplay-util.py reads it for status, and the od-sender@ drop-in
# below checks it before every auto-connect start).
WIFI_OFF="$SETTINGS/wifi-disabled"
DROPIN_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/od-sender@.service.d"
DROPIN="$DROPIN_DIR/omarchy-opendisplay-wifi.conf"
RELEASE_API="https://api.github.com/repos/peetzweg/opendisplay/releases/latest"
CURL=(curl --proto '=https' --proto-redir '=https' --tlsv1.2 -fsSL --max-time 60)

ID_RE='^[0-9A-Fa-f][0-9A-Fa-f-]{7,63}$'
ADDR_RE='^[[A-Za-z0-9][]A-Za-z0-9.:[-]{0,79}:([0-9]{1,5})$'
UNIT_RE='^(opendisplay-[0-9a-f]{8}|opendisplay-(addr|usb)-[0-9a-f]{8}|od-sender@[A-Za-z0-9\\_.:-]{1,300})\.service$'
UDID_RE='^[0-9A-Fa-f][0-9A-Fa-f-]{15,63}$'

# The transient units' Description is "<DESC_PREFIX><to>"; opendisplay-util.py
# parses it back (DESC_PREFIX there). Keep the two in sync.
DESC_PREFIX="OpenDisplay to "

export NO_COLOR=1

# Exit codes (also listed in usage): 0 ok, 1 other failure, 2 invalid argument
# or usage, 5 config saved but doctor unhappy, 6 config rejected and rolled
# back, 7 template unit missing, 8 od-sender not installed, 9 external sender
# running, 10 managed by pacman, 11 GitHub unreachable, 12 Wi-Fi connections
# are off, 13 usbmuxd isn't available, 14 receiver isn't connected by USB. The
# message is always the last line of stderr.
die_code() { local code="$1"; shift; printf '%s\n' "$*" >&2; exit "$code"; }
die() { die_code 1 "$*"; }

# Every bar watches this file to refresh after something changed. It is
# written in place (never replaced) so file watchers keep working.
stamp_change() {
  mkdir -p "$STATE" 2>/dev/null
  date +%s%N > "$STATE/changed" 2>/dev/null
  return 0
}

valid_id() { [[ ${1-} =~ $ID_RE ]]; }

valid_addr() {
  [[ ${1-} =~ $ADDR_RE ]] || return 1
  local port=$((10#${BASH_REMATCH[1]}))
  (( port >= 1 && port <= 65535 ))
}

valid_unit() { [[ ${1-} =~ $UNIT_RE ]]; }

need_id() { valid_id "${1-}" || die_code 2 "invalid receiver id"; }

# --- unit names: the only places these are built ----------------------------

transient_unit() {  # <id>
  local hex="${1//-/}"
  hex="${hex,,}"
  printf 'opendisplay-%s.service' "${hex:0:8}"
}

addr_unit() {  # <host:port>
  local sum
  sum="$(printf '%s' "$1" | sha1sum)"
  printf 'opendisplay-addr-%s.service' "${sum:0:8}"
}

usb_unit() {  # <id>
  local hex="${1//-/}"
  hex="${hex,,}"
  printf 'opendisplay-usb-%s.service' "${hex:0:8}"
}

template_unit() {  # <id>
  printf 'od-sender@%s.service' "$(systemd-escape -- "$1")"
}

output_for_id() {  # <id>
  local hex="${1//-/}"
  hex="${hex,,}"
  printf 'od-%s' "${hex:0:6}"
}

# --- od-sender --------------------------------------------------------------

find_sender() {
  local p
  if p="$(command -v od-sender 2>/dev/null)" && [[ -x $p ]]; then
    printf '%s' "$p"
  elif [[ -x $HOME/.local/bin/od-sender ]]; then
    printf '%s' "$HOME/.local/bin/od-sender"
  else
    return 1
  fi
}

require_sender() {
  SENDER="$(find_sender)" || die_code 8 "od-sender is not installed"
}

sender_version() {  # <path>
  local out
  out="$(timeout 10 "$1" --version 2>/dev/null)" || return 1
  [[ $out =~ ^od-sender\ ([0-9]+\.[0-9]+\.[0-9]+) ]] || return 1
  printf '%s' "${BASH_REMATCH[1]}"
}

unit_state() { systemctl --user show -p ActiveState --value -- "$1" 2>/dev/null; }

unit_active() {
  case "$(unit_state "$1")" in active|activating|reloading) return 0 ;; esac
  return 1
}

# PID of a live sender for an output, from its lock file. The lock file stays
# behind after the sender exits, so the PID must be alive and be od-sender.
lock_pid() {  # <output>
  local lock="$LOCKS/$1.lock" pid comm
  [[ -r $lock ]] || return 1
  read -r pid < "$lock" || return 1
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  comm="$(cat "/proc/$pid/comm" 2>/dev/null)" || return 1
  [[ $comm == od-sender ]] || return 1
  printf '%s' "$pid"
}

json_field() {  # <json> <field>
  "${PY[@]}" -c 'import json,sys
v = json.loads(sys.argv[1]).get(sys.argv[2])
print("" if v is None else (str(v).lower() if isinstance(v, bool) else v))' "$1" "$2"
}

# --- sessions ---------------------------------------------------------------

start_transient() {  # <unit> <to>
  local unit="$1" to="$2"
  # Every network connect goes through here, including restores after an update.
  wifi_enabled || { echo "Wi-Fi connections are turned off" >&2; return 12; }
  case "$(unit_state "$unit")" in
    active|activating) echo "already connected"; return 0 ;;
    failed) systemctl --user reset-failed -- "$unit" 2>/dev/null ;;
  esac
  systemd-run --user --quiet --unit="$unit" --description="$DESC_PREFIX$to" \
    --setenv=NO_COLOR=1 --property=Restart=no -- "$SENDER" run --to="$to" \
    || { echo "couldn't start $unit" >&2; return 1; }
  echo "$unit"
}

wifi_enabled() { [[ ! -e $WIFI_OFF ]]; }

require_wifi() {
  wifi_enabled || die_code 12 "Wi-Fi connections are turned off"
}

cmd_connect() {
  need_id "${1-}"
  local id="$1"
  require_wifi
  require_sender
  if unit_active "$(template_unit "$id")"; then echo "already connected (auto-connect)"; return 0; fi
  if unit_active "$(usb_unit "$id")"; then echo "already connected (USB)"; return 0; fi
  if lock_pid "$(output_for_id "$id")" >/dev/null; then echo "already connected"; return 0; fi
  start_transient "$(transient_unit "$id")" "$id"
}

cmd_connect_addr() {
  valid_addr "${1-}" || die_code 2 "invalid address; use host:port"
  require_wifi
  require_sender
  start_transient "$(addr_unit "$1")" "$1"
}

# The usbmuxd socket override is passed on to the unit so it talks to the same
# usbmuxd as this helper; only plain paths and host:port are accepted.
usbmux_env() {
  local v="${USBMUXD_SOCKET_ADDRESS-}"
  [[ -z $v ]] && return 0
  if [[ $v =~ ^UNIX:/[A-Za-z0-9/._-]{1,200}$ || $v =~ ^[A-Za-z0-9.-]{1,80}:[0-9]{1,5}$ ]]; then
    printf -- '--setenv=USBMUXD_SOCKET_ADDRESS=%s' "$v"
  fi
}

# USB session: one transient unit whose main process is bin/usbmux.py. It
# listens on a free loopback port, runs `od-sender run --to=127.0.0.1:<port>`
# as its child (same cgroup, so status, logs and stop work as for any other
# session), forwards that port to TCP 9000 on the device through usbmuxd, and
# ends the session when the device is unplugged. Exits with od-sender's code.
start_usb() {  # <id>
  local id="$1" unit udid rc=0 py env
  unit="$(usb_unit "$id")"
  case "$(unit_state "$unit")" in
    active|activating) echo "already connected"; return 0 ;;
    failed) systemctl --user reset-failed -- "$unit" 2>/dev/null ;;
  esac
  udid="$("${PY[@]}" "$USBMUX" find "$id")" || rc=$?
  case "$rc" in
    0) ;;
    13) echo "USB needs usbmuxd: sudo pacman -S usbmuxd" >&2; return 13 ;;
    14) echo "receiver isn't connected by USB" >&2; return 14 ;;
    *) echo "couldn't look for USB devices" >&2; return 1 ;;
  esac
  [[ $udid =~ $UDID_RE ]] || { echo "unexpected UDID from usbmux.py" >&2; return 1; }
  py="$(command -v python3)" || { echo "python3 not found" >&2; return 1; }
  # KillMode=mixed: stop SIGTERMs only usbmux.py, which SIGINTs od-sender
  # (escalating if it hangs) so it can remove its display first.
  local args=(--user --quiet --unit="$unit" --description="$DESC_PREFIX$id"
    --setenv=NO_COLOR=1 --property=Restart=no --property=KillMode=mixed)
  env="$(usbmux_env)"
  [[ -n $env ]] && args+=("$env")
  # Only now that the device is known to be on USB: a waiting auto-connect
  # sender would connect over Wi-Fi as well and fight this one. Stop it (it
  # stays enabled and starts again at the next login).
  local tpl
  tpl="$(template_unit "$id")"
  if unit_active "$tpl"; then stop_units "$tpl"; fi
  systemd-run "${args[@]}" -- "$py" -I "$USBMUX" run --udid="$udid" --sender="$SENDER" \
    || { echo "couldn't start $unit" >&2; return 1; }
  echo "$unit"
}

cmd_connect_usb() {
  need_id "${1-}"
  local id="$1" rc=0
  require_sender
  if unit_active "$(usb_unit "$id")"; then echo "already connected"; return 0; fi
  if unit_active "$(transient_unit "$id")" || lock_pid "$(output_for_id "$id")" >/dev/null; then
    echo "already connected"; return 0
  fi
  start_usb "$id" || rc=$?
  (( rc == 0 )) || exit "$rc"
}

cmd_usb_list() {
  exec "${PY[@]}" "$USBMUX" list
}

stop_units() {
  local u
  for u in "$@"; do
    systemctl --user stop -- "$u" 2>/dev/null
    [[ $(unit_state "$u") == failed ]] && systemctl --user reset-failed -- "$u" 2>/dev/null
  done
  return 0
}

wait_gone() {  # <output> <seconds>
  local i
  for ((i = 0; i < $2 * 10; i++)); do
    lock_pid "$1" >/dev/null || return 0
    sleep 0.1
  done
  return 1
}

cmd_disconnect() {
  local target="${1-}" output pid
  if valid_unit "$target"; then
    stop_units "$target"
    return 0
  fi
  if [[ $target =~ ^od-[0-9a-f]{6}$ ]]; then
    output="$target"  # an external sender whose receiver id isn't known
  else
    need_id "$target"
    stop_units "$(transient_unit "$target")" "$(usb_unit "$target")" "$(template_unit "$target")"
    output="$(output_for_id "$target")"
  fi
  wait_gone "$output" 3 && return 0
  # A sender started outside the plugin (or stuck, see upstream bug 1).
  pid="$(lock_pid "$output")" || return 0
  kill -INT "$pid" 2>/dev/null
  wait_gone "$output" 3 && return 0
  pid="$(lock_pid "$output")" || return 0
  kill -TERM "$pid" 2>/dev/null
  wait_gone "$output" 2 || die "od-sender (pid $pid) didn't stop"
}

# With Wi-Fi connections off, only USB units may be (re)started.
require_wifi_for_unit() {  # <unit>
  [[ $1 == opendisplay-usb-* ]] || require_wifi
}

cmd_restart() {
  local target="${1-}" u
  if valid_unit "$target"; then
    require_wifi_for_unit "$target"
    systemctl --user restart -- "$target" || die "couldn't restart $target"
    return
  fi
  need_id "$target"
  for u in "$(template_unit "$target")" "$(usb_unit "$target")" "$(transient_unit "$target")"; do
    if unit_active "$u"; then
      require_wifi_for_unit "$u"
      systemctl --user restart -- "$u" || die "couldn't restart $u"
      return
    fi
  done
  if lock_pid "$(output_for_id "$target")" >/dev/null; then
    require_wifi  # reconnecting an external sender goes over the network
    cmd_disconnect "$target" && cmd_connect "$target"
  fi
}

cmd_autoconnect() {
  need_id "${1-}"
  local id="$1" mode="${2-}" tpl transient
  tpl="$(template_unit "$id")"
  transient="$(transient_unit "$id")"
  case "$mode" in
    on)
      "${PY[@]}" "$UTIL" template-installed \
        || die_code 7 "Auto-connect needs the od-sender systemd unit"
      # Two senders for one receiver would fight; the template takes over.
      unit_active "$transient" && stop_units "$transient"
      systemctl --user enable --now -- "$tpl" || die "couldn't enable auto-connect"
      ;;
    off)
      local was_active=0
      unit_active "$tpl" && was_active=1
      systemctl --user disable --now -- "$tpl" 2>/dev/null
      [[ $(unit_state "$tpl") == failed ]] && systemctl --user reset-failed -- "$tpl" 2>/dev/null
      # Turning auto-connect off shouldn't drop a display that's in use.
      if (( was_active )); then cmd_connect "$id"; fi
      return 0
      ;;
    *) die_code 2 "usage: autoconnect <id> on|off" ;;
  esac
}

cmd_logs() {
  valid_unit "${1-}" || die_code 2 "invalid unit"
  local since
  since="$(systemctl --user show -p InactiveExitTimestamp --timestamp=unix --value -- "$1" 2>/dev/null)"
  if [[ $since =~ ^@[0-9]+$ ]]; then
    # Replay the current run only (never an earlier one), capped.
    exec journalctl --user -u "$1" -o cat -f -n 200 --since="$since"
  fi
  exec journalctl --user -u "$1" -o cat -f -n 0
}

cmd_list() {
  # No network scanning at all while Wi-Fi connections are off.
  if ! wifi_enabled; then echo '[]'; return 0; fi
  require_sender
  exec timeout 15 "$SENDER" list --json --timeout 3
}

# Quotes a path for a systemd unit file: "..." with \, " and % escaped.
systemd_quote() {
  local v="$1"
  v="${v//\\/\\\\}"
  v="${v//\"/\\\"}"
  v="${v//%/%%}"
  v="${v//\$/\$\$}"
  printf '"%s"' "$v"
}

cmd_wifi() {
  case "${1-}" in
    status|"")
      if wifi_enabled; then echo on; else echo off; fi ;;
    off)
      mkdir -p "$SETTINGS" "$DROPIN_DIR" || die "couldn't create $SETTINGS"
      : > "$WIFI_OFF" || die "couldn't write $WIFI_OFF"
      # Auto-connect units stay enabled (the user's choice) but are skipped
      # while the flag exists; ExecCondition makes a skip a clean no-op.
      printf '# Written by the OpenDisplay Omarchy widget; removed when Wi-Fi connections are turned back on.\n[Service]\nExecCondition=test ! -e %s\n' \
        "$(systemd_quote "$WIFI_OFF")" > "$DROPIN" || die "couldn't write $DROPIN"
      systemctl --user daemon-reload 2>/dev/null
      # Disconnect every running Wi-Fi session (USB sessions keep running).
      local status unit
      status="$("${PY[@]}" "$UTIL" status)"
      while read -r unit; do
        [[ -n $unit ]] && valid_unit "$unit" && stop_units "$unit"
      done < <("${PY[@]}" "$UTIL" wifi-units <<< "$status")
      echo off ;;
    on)
      rm -f -- "$WIFI_OFF" "$DROPIN"
      rmdir -- "$DROPIN_DIR" "$SETTINGS" 2>/dev/null
      systemctl --user daemon-reload 2>/dev/null
      # Enabled auto-connect units were skipped while Wi-Fi was off; start
      # them, except for a receiver already connected (say, by USB), where a
      # second sender would fight the first.
      local id
      while read -r id; do
        valid_id "$id" || continue
        unit_active "$(usb_unit "$id")" && continue
        unit_active "$(transient_unit "$id")" && continue
        lock_pid "$(output_for_id "$id")" >/dev/null && continue
        systemctl --user start -- "$(template_unit "$id")" 2>/dev/null
      done < <("${PY[@]}" "$UTIL" autoconnect-ids)
      echo on ;;
    *) die_code 2 "usage: wifi on|off|status" ;;
  esac
}

# The last ERROR line of a unit's most recent run, for a connect that failed
# before the log tail saw it.
cmd_last_error() {
  valid_unit "${1-}" || die_code 2 "invalid unit"
  local since args=(--user -u "$1" -o cat -n 200 --no-pager)
  since="$(systemctl --user show -p InactiveExitTimestamp --timestamp=unix --value -- "$1" 2>/dev/null)"
  [[ $since =~ ^@[0-9]+$ ]] && args+=(--since="$since")
  journalctl "${args[@]}" 2>/dev/null | grep ' ERROR ' | tail -n1 | cut -c1-4096
}

# The connected/hello/Extending lines of a unit's current run, so a session
# that started long ago still has its receiver's name and address.
cmd_first_lines() {
  valid_unit "${1-}" || die_code 2 "invalid unit"
  local since
  since="$(systemctl --user show -p InactiveExitTimestamp --timestamp=unix --value -- "$1" 2>/dev/null)"
  [[ $since =~ ^@[0-9]+$ ]] || return 0
  journalctl --user -u "$1" -o cat --no-pager --since="$since" 2>/dev/null \
    | grep -m3 -E '^[0-9TZ:.-]+ +INFO (connected to receiver|hello:|Extending onto)' | cut -c1-4096
  return 0
}

# --- install / update -------------------------------------------------------

cmd_version() {
  local path ver managed=other
  if ! path="$(find_sender)" || ! ver="$(sender_version "$path")"; then
    echo '{"installed": false}'
    return 0
  fi
  if [[ $path == "$HOME/.local/bin/"* ]]; then
    managed=user
  elif command -v pacman >/dev/null && pacman -Qqo -- "$path" >/dev/null 2>&1; then
    managed=package
  fi
  "${PY[@]}" -c 'import json,sys; print(json.dumps({"installed": True, "version": sys.argv[1], "path": sys.argv[2], "managed": sys.argv[3]}))' \
    "$ver" "$path" "$managed"
}

arch_name() {
  case "$(uname -m)" in
    x86_64) echo x86_64 ;;
    aarch64|arm64) echo aarch64 ;;
    *) return 1 ;;
  esac
}

# Prints the path of a release JSON file. Without <force>, a copy younger than
# 6 hours is reused with no network, so every bar on every monitor shares one
# check; with it, GitHub is always asked (with the ETag).
fetch_release() {  # <force: 0|1>
  mkdir -p "$CACHE"
  if [[ -n ${OMARCHY_OPENDISPLAY_RELEASE_FILE-} ]]; then  # tests / manual acceptance
    printf '%s' "$OMARCHY_OPENDISPLAY_RELEASE_FILE"
    return 0
  fi
  local cached="$CACHE/release.json" etag="$CACHE/release.etag" tmp code
  if [[ $1 != 1 && -s $cached ]] && (( $(date +%s) - $(stat -c %Y "$cached") < 21600 )); then
    printf '%s' "$cached"
    return 0
  fi
  tmp="$(mktemp "$CACHE/release.XXXXXX")"
  local args=("${CURL[@]}" --max-filesize 1M -H 'Accept: application/vnd.github+json' -o "$tmp" -w '%{http_code}' --etag-save "$etag.new")
  [[ -s $cached && -s $etag ]] && args+=(--etag-compare "$etag")
  if ! code="$("${args[@]}" "$RELEASE_API")"; then
    rm -f "$tmp" "$etag.new"
    die_code 11 "Couldn't reach GitHub"
  fi
  if [[ $code == 304 ]]; then
    rm -f "$tmp" "$etag.new"
    touch -c -- "$cached"  # unchanged, but checked just now
  else
    mv -f "$tmp" "$cached"
    if [[ -s $etag.new ]]; then mv -f "$etag.new" "$etag"; else rm -f "$etag.new"; fi
  fi
  printf '%s' "$cached"
}

cmd_check_update() {
  local force=0 arch file installed="" path
  case "${1-}" in
    "") ;;
    --force) force=1 ;;
    *) die_code 2 "usage: check-update [--force]" ;;
  esac
  arch="$(arch_name)" || die "unsupported architecture: $(uname -m)"
  file="$(fetch_release "$force")" || exit $?
  path="$(find_sender)" && installed="$(sender_version "$path")"
  "${PY[@]}" "$UTIL" release "$file" "$arch" "${installed:-none}"
}

download() {  # <url> <dest>
  if [[ -n ${OMARCHY_OPENDISPLAY_DOWNLOAD_DIR-} ]]; then  # tests only
    cp -- "$OMARCHY_OPENDISPLAY_DOWNLOAD_DIR/${1##*/}" "$2"
    return
  fi
  "${CURL[@]}" --max-filesize 50M -o "$2" "$1"
}

# Sessions stopped for an install, restarted afterwards (or when it fails).
PLAN=""
UNITS_STOPPED=0
UNITS_RESTORED=0
RESTORE_FAILED=0
INSTALL_TMP=""

restore_units() {
  (( UNITS_RESTORED )) && return 0
  UNITS_RESTORED=1
  local kind unit to
  SENDER="$(find_sender)" || SENDER=""
  while read -r kind unit to; do
    [[ -n ${unit-} ]] || continue
    case "$kind" in
      template) valid_unit "$unit" && systemctl --user start -- "$unit" ;;
      id) valid_id "$to" && start_transient "$(transient_unit "$to")" "$to" >/dev/null ;;
      addr) valid_addr "$to" && start_transient "$(addr_unit "$to")" "$to" >/dev/null ;;
      usb) valid_id "$to" && [[ -n $SENDER ]] && start_usb "$to" >/dev/null ;;
      *) false ;;
    esac || { echo "couldn't restart $unit" >&2; RESTORE_FAILED=1; }
  done <<< "$PLAN"
  return 0
}

install_exit() {
  local rc=$?
  trap - EXIT
  (( UNITS_STOPPED )) && restore_units
  [[ -n $INSTALL_TMP ]] && rm -rf -- "$INSTALL_TMP"
  stamp_change
  exit "$rc"
}

cmd_install() {
  trap install_exit EXIT
  (( EUID != 0 )) || die "Run as your user, not root"
  mkdir -p "$CACHE" "$STATE"
  exec 7> "$STATE/install.lock"
  flock -n 7 || die "an install is already running"
  local log="$CACHE/last-update.log"
  # Everything below is also kept for the "Details" view.
  exec > >(tee "$log") 2>&1

  local vinfo
  vinfo="$(cmd_version)"
  if [[ $(json_field "$vinfo" managed) == package ]]; then
    die_code 10 "od-sender is installed by pacman; update it with your package manager"
  fi

  local arch info url digest sha_url latest
  arch="$(arch_name)" || die "unsupported architecture: $(uname -m)"
  info="$(cmd_check_update --force)" || exit $?
  url="$(json_field "$info" url)"
  digest="$(json_field "$info" digest)"
  sha_url="$(json_field "$info" sha256Url)"
  latest="$(json_field "$info" latest)"
  [[ -n $url ]] || die "the release has no od-sender build for $arch"
  [[ -n $sha_url && -n $digest ]] || die "the release has no checksum for od-sender; not installing"

  local top="od-sender-$arch-unknown-linux-gnu"
  INSTALL_TMP="$(mktemp -d "$CACHE/install.XXXXXX")"
  local tmp="$INSTALL_TMP"
  echo "Downloading od-sender $latest"
  download "$url" "$tmp/od-sender.tar.gz" || die "download failed"
  download "$sha_url" "$tmp/od-sender.tar.gz.sha256" || die "checksum download failed"
  "${PY[@]}" "$UTIL" verify-sha "$tmp/od-sender.tar.gz" "$tmp/od-sender.tar.gz.sha256" "$digest" || exit 1
  echo "Checksum verified (sha256 matches the release file and GitHub's digest)"
  "${PY[@]}" "$UTIL" check-tar "$tmp/od-sender.tar.gz" "$top" || exit 1
  mkdir "$tmp/x"
  tar -xzf "$tmp/od-sender.tar.gz" -C "$tmp/x" --no-same-owner --no-same-permissions || die "couldn't unpack the archive"
  [[ -f $tmp/x/$top/install.sh && -f $tmp/x/$top/od-sender ]] || die "unexpected archive layout"

  # Stop what's running, remembering it so it comes back afterwards.
  local status
  status="$("${PY[@]}" "$UTIL" status)"
  PLAN="$("${PY[@]}" "$UTIL" install-plan <<< "$status")" || die "couldn't work out what is running"
  if [[ $PLAN == EXTERNAL* ]]; then
    PLAN=""
    die_code 9 "Stop the od-sender running in your terminal first"
  fi
  local kind unit to
  UNITS_STOPPED=1  # from here on, any exit restarts the sessions
  while read -r kind unit to; do
    [[ -n ${unit-} ]] && valid_unit "$unit" && stop_units "$unit"
  done <<< "$PLAN"

  echo "Running the official install.sh"
  ( cd "$tmp/x/$top" && bash ./install.sh ) || die "install.sh failed"

  SENDER="$(find_sender)" || die "od-sender isn't on PATH after installing"
  restore_units

  local now
  now="$(sender_version "$SENDER")" || die "od-sender doesn't run after installing"
  [[ $now == "$latest" ]] || die "expected od-sender $latest, found $now"
  echo "Installed od-sender $now"
  (( RESTORE_FAILED == 0 )) || die "od-sender was installed, but some sessions didn't restart"
}

# --- sender.toml ------------------------------------------------------------

doctor_code() {
  local s
  s="$(find_sender)" || { echo 1; return; }
  timeout 20 "$s" doctor >/dev/null 2>&1
  echo $?
}

cmd_config_set() {
  mkdir -p "$STATE"
  exec 9> "$STATE/config.lock"
  flock -w 15 9 || die "sender.toml is busy"
  local before after
  before="$(doctor_code)"
  local rc=0
  "${PY[@]}" "$CONFIG_TOOL" set "$@" || rc=$?
  (( rc == 0 )) || exit "$rc"  # 2 for a bad key or value, 1 otherwise
  after="$(doctor_code)"
  if [[ $before == 0 && $after == 2 ]]; then
    "${PY[@]}" "$CONFIG_TOOL" rollback
    die_code 6 "od-sender rejected the setting"
  fi
  if [[ $after != 0 ]]; then
    die_code 5 "Saved, but od-sender doctor isn't happy"
  fi
}

# --- notifications ----------------------------------------------------------

# Every bar (one per monitor) runs its own copy of the widget, so the same
# event can be reported more than once; send each <key> at most once a minute.
# The body is already markup-escaped by the caller and passed as one argument.
cmd_notify() {
  local key="${1-}" body="${2-}"
  [[ $key =~ ^[A-Za-z0-9._:@-]{1,200}$ ]] || die_code 2 "invalid notification key"
  mkdir -p "$STATE"
  exec 8> "$STATE/notify.lock"
  flock -w 5 8 || return 0
  local stamp
  stamp="$STATE/notified-$(printf '%s' "$key" | sha1sum | cut -c1-16)"
  if [[ -e $stamp ]] && (( $(date +%s) - $(stat -c %Y "$stamp") < 60 )); then return 0; fi
  touch "$stamp"
  notify-send -a OpenDisplay -- OpenDisplay "${body:0:300}"
}

# --- terminals --------------------------------------------------------------

launch_terminal() {
  if command -v uwsm-app >/dev/null; then
    setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title=OpenDisplay -e "$@" >/dev/null 2>&1 &
  else
    setsid xdg-terminal-exec -e "$@" >/dev/null 2>&1 &
  fi
  disown
}

press_any_key() { echo; read -rsn1 -p 'Press any key to close' || true; }

cmd_doctor_run() {
  if require_sender_quiet; then "$SENDER" doctor; echo "(exit $?)"; else echo "od-sender is not installed"; fi
  echo
  if wifi_enabled; then echo "Wi-Fi connections: on"; else echo "Wi-Fi connections: off (USB only, no network scanning)"; fi
  case "$("${PY[@]}" "$USBMUX" state 2>/dev/null)" in
    running) echo "USB: usbmuxd is running"; "${PY[@]}" "$USBMUX" list 2>/dev/null ;;
    installed) echo "USB: usbmuxd is installed (it starts when an iPhone or iPad is plugged in)" ;;
    *) echo "USB needs usbmuxd: sudo pacman -S usbmuxd" ;;
  esac
  press_any_key
}

require_sender_quiet() { SENDER="$(find_sender)"; }

cmd_details_run() {
  if [[ -r $CACHE/last-update.log ]]; then cat -v -- "$CACHE/last-update.log"; else echo "No update log yet."; fi
  press_any_key
}

usage() {
  cat <<'EOF'
usage: omarchy-opendisplay <command> [args]

Commands
  connect <id>                 connect a receiver
  connect-addr <host:port>     connect by address
  connect-usb <id>             connect a receiver plugged in by USB (needs usbmuxd)
  usb-list                     receivers on USB, as JSON
  wifi on|off|status           allow or block Wi-Fi connections and scanning
  disconnect <id|unit>         stop a session
  restart <id|unit>            restart a session
  autoconnect <id> on|off      turn auto-connect on or off
  status [--json]              sessions, units and auto-connect as JSON
  logs <unit>                  follow a unit's log
  list                         discover receivers
  version                      installed od-sender, as JSON
  check-update [--force]       latest release, as JSON (cached for 6 hours)
  install | update             install or update od-sender
  config-get                   sender.toml as JSON
  config-set [--receiver <id>] key=value...
  doctor                       run od-sender doctor in a terminal
  details                      show the last install log in a terminal

Internal (used by the widget and tests)
  last-error <unit>  first-lines <unit>  notify <key> <body>
  doctor-run  details-run  unit-names <id>  addr-unit <host:port>  usb-unit <id>

Exit codes
  0   success
  1   other failure (the last line of stderr says why)
  2   invalid argument (id, address, unit, key or value) or bad usage
  5   config-set saved, but od-sender doctor isn't happy afterwards
  6   config-set rejected by od-sender; the change was rolled back
  7   auto-connect needs the od-sender systemd unit, which isn't installed
  8   od-sender is not installed
  9   install/update refused: an od-sender started outside the plugin is running
  10  install/update refused: od-sender is managed by pacman
  11  couldn't reach GitHub
  12  connect refused: Wi-Fi connections are turned off
  13  USB needs usbmuxd, which isn't running or installed
  14  the receiver isn't connected by USB (or its app isn't open)
EOF
}

main() {
  local cmd="${1-}"
  shift || true
  case "$cmd" in
    connect|connect-addr|connect-usb|disconnect|restart|autoconnect|config-set|wifi) trap stamp_change EXIT ;;
  esac
  case "$cmd" in
    connect) cmd_connect "$@" ;;
    connect-addr) cmd_connect_addr "$@" ;;
    connect-usb) cmd_connect_usb "$@" ;;
    usb-list) cmd_usb_list ;;
    wifi) cmd_wifi "$@" ;;
    disconnect) cmd_disconnect "$@" ;;
    restart) cmd_restart "$@" ;;
    autoconnect) cmd_autoconnect "$@" ;;
    status)
      [[ $# -eq 0 || ( $# -eq 1 && $1 == --json ) ]] || die_code 2 "usage: status [--json]"
      mkdir -p "$STATE"
      [[ -e $STATE/changed ]] || date +%s%N > "$STATE/changed"
      exec "${PY[@]}" "$UTIL" status ;;
    logs) cmd_logs "$@" ;;
    list) cmd_list ;;
    last-error) cmd_last_error "$@" ;;
    first-lines) cmd_first_lines "$@" ;;
    notify) cmd_notify "$@" ;;
    version) cmd_version ;;
    check-update) cmd_check_update "$@" ;;
    install|update) cmd_install ;;
    config-get) exec "${PY[@]}" "$CONFIG_TOOL" get --json ;;
    config-set) cmd_config_set "$@" ;;
    doctor) launch_terminal "$HERE/omarchy-opendisplay" doctor-run ;;
    doctor-run) cmd_doctor_run ;;
    details) launch_terminal "$HERE/omarchy-opendisplay" details-run ;;
    details-run) cmd_details_run ;;
    unit-names) need_id "${1-}"; transient_unit "$1"; echo; template_unit "$1"; echo; output_for_id "$1"; echo ;;
    usb-unit) need_id "${1-}"; usb_unit "$1"; echo ;;
    addr-unit) valid_addr "${1-}" || die_code 2 "invalid address"; addr_unit "$1"; echo ;;
    -h|--help|help|"") usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
